@page "/perfil"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ApiService ApiService

<PageTitle>Perfil - QLNA</PageTitle>

<h1 class="perfil-title">Perfil</h1>

<div class="pron-selector-wrap">
    <label class="pron-selector-label">Selecciona Torneo:</label>
    <select class="pron-selector" @onchange="OnTorneoChanged" value="@_torneoSeleccionadoId">
        @foreach (var torneo in _torneos)
        {
            <option value="@torneo.id">@torneo.nombre</option>
        }
    </select>
</div>

@if (_perfil is null)
{
    <p class="muted">Cargando...</p>
}
else
{
    <div class="perfil-card">
        <div class="perfil-field">
            <label class="perfil-label">Nombre</label>
            <input class="perfil-input" type="text" @bind="_editable.nombre" placeholder="Tu nombre" />
        </div>
        <div class="perfil-field">
            <label class="perfil-label">Alias</label>
            <input class="perfil-input" type="text" @bind="_editable.alias" placeholder="Tu alias o equipo" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="message @(_messageOk ? "success" : "error")">@_message</div>
        }

        <div class="perfil-actions">
            <button class="btn-primary perfil-btn-save" @onclick="Guardar" disabled="@_saving">
                @(_saving ? "Guardando..." : "Guardar cambios")
            </button>
            <button class="btn-secondary perfil-btn-discard" @onclick="Descartar">
                Descartar cambios
            </button>
        </div>
    </div>
}

@code {
    private List<Torneo> _torneos = new();
    private int _torneoSeleccionadoId = 1;
    private PerfilDto? _perfil;
    private ActualizarPerfilRequest _editable = new();
    private bool _saving;
    private string? _message;
    private bool _messageOk;

    protected override async Task OnInitializedAsync()
    {
        _torneos = (await ApiService.GetTorneosAsync()).ToList();
        var activo = _torneos.FirstOrDefault(x => x.activo);
        _torneoSeleccionadoId = (activo ?? _torneos.FirstOrDefault())?.id ?? 1;
        await CargarPerfil();
    }

    private async Task OnTorneoChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var id))
        {
            _torneoSeleccionadoId = id;
            _message = null;
            await CargarPerfil();
        }
    }

    private async Task Guardar()
    {
        _saving = true;
        _message = null;

        var updated = await ApiService.ActualizarPerfilAsync(_torneoSeleccionadoId, _editable);
        _saving = false;

        if (updated is null)
        {
            _messageOk = false;
            _message = "No se pudo actualizar el perfil.";
            return;
        }

        _perfil = updated;
        _editable = new ActualizarPerfilRequest
        {
            nombre = _perfil.nombre,
            alias = _perfil.alias,
            email = _perfil.email,
            telefono = _perfil.telefono
        };
        _messageOk = true;
        _message = "Perfil actualizado ✓";
    }

    private void Descartar()
    {
        if (_perfil is null) return;
        _editable = new ActualizarPerfilRequest
        {
            nombre = _perfil.nombre,
            alias = _perfil.alias,
            email = _perfil.email,
            telefono = _perfil.telefono
        };
        _message = null;
    }

    private async Task CargarPerfil()
    {
        _perfil = await ApiService.GetPerfilAsync(_torneoSeleccionadoId);
        if (_perfil is null) return;

        _editable = new ActualizarPerfilRequest
        {
            nombre = _perfil.nombre,
            alias = _perfil.alias,
            email = _perfil.email,
            telefono = _perfil.telefono
        };
    }
}
