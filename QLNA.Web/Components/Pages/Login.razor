@layout AuthLayout
@page "/login"
@attribute [AllowAnonymous]
@inject ApiService ApiService
@inject AuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Login - QLNA</PageTitle>

<div class="login-head">
    <h1>QLNA</h1>
    <p>Quiniela 100x100</p>
</div>

<EditForm Model="_request" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />

    <div class="field">
        <label for="dni">DNI/NIE</label>
        <InputText id="dni" @bind-Value="_request.dni_nie" class="input" />
    </div>

    <div class="field">
        <label for="password">Contraseña</label>
        <InputText id="password" @bind-Value="_request.password" type="password" class="input" />
    </div>

    <button class="btn btn-cta btn-block" type="submit" disabled="@_loading">@(_loading ? "Entrando..." : "Entrar")</button>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="message error login-error">@_error</p>
    }
</EditForm>

@code {
    private readonly LoginRequest _request = new();
    private string? _error;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/pronosticos", forceLoad: true);
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(_request.dni_nie) || string.IsNullOrWhiteSpace(_request.password))
        {
            _error = "DNI/NIE y contraseña son obligatorios.";
            return;
        }

        _loading = true;
        _error = null;

        var ok = await ApiService.LoginAsync(_request.dni_nie.Trim(), _request.password);
        if (!ok)
        {
            _error = "Credenciales incorrectas";
            _loading = false;
            return;
        }

        await AuthStateProvider.NotifyLoginAsync();
        Navigation.NavigateTo("/pronosticos", forceLoad: true);
        _loading = false;
    }
}
