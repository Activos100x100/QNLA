@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

<PageTitle>Login - QLNA</PageTitle>

<div class="login-shell">
    <div class="login-brand">
        <img class="login-logo" src="/img/logo.png" alt="Activos 100x100" />
        <p class="login-brand-copy">Accede a la quiniela con tu usuario y contraseña.</p>
    </div>

    <div class="card login-card">
        <div class="card-h">
            <h1 class="title">Iniciar sesión</h1>
            <p class="sub">Usa las credenciales que te ha facilitado el equipo.</p>
        </div>

        <div class="content">
            <form method="post" action="/auth/login" data-enhance="false">
                <AntiforgeryToken />

                <div class="field">
                    <label for="DniNie">Usuario</label>
                    <input id="DniNie" name="DniNie" autocomplete="username" required />
                </div>

                <div class="field">
                    <label for="Password">Contraseña</label>
                    <input id="Password" name="Password" type="password" autocomplete="current-password" required />
                </div>

                <div class="row">
                    <button class="btn-primary btn-full" type="submit">Entrar</button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="validation">@_error</div>
                }
            </form>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? ErrorCode { get; set; }

    private string? _error;

    protected override void OnParametersSet()
    {
        if (HttpContext?.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/pronosticos", forceLoad: true);
            return;
        }

        _error = ErrorCode switch
        {
            "missing" => "Usuario y contraseña son obligatorios.",
            "invalid" => "Credenciales incorrectas.",
            _ => null
        };
    }
}
