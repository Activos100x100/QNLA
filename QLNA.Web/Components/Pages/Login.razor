@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject ApiService ApiService
@inject NavigationManager Navigation
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies

<PageTitle>Login - QLNA</PageTitle>

<div class="login-shell">
    <img class="login-logo" src="/img/logo.svg" alt="Activos 100x100" />

    <div class="card">
        <div class="card-h">
            <h1 class="title">Login</h1>
            <p class="sub">Accede con tu DNI/NIE y contraseña.</p>
        </div>

        <div class="content">
            <form method="post" @formname="login" @onsubmit="HandleLogin" data-enhance="false">
                <AntiforgeryToken />

                <div class="field">
                    <label for="DniNie">Usuario</label>
                    <InputText id="DniNie" @bind-Value="Input!.DniNie" autocomplete="username" />
                </div>

                <div class="field">
                    <label for="Password">Contraseña</label>
                    <InputText id="Password" @bind-Value="Input!.Password" type="password" autocomplete="current-password" />
                </div>

                <div class="row">
                    <button class="btn-primary" type="submit">Entrar</button>
                    <a class="link" href="#">Olvidé mi contraseña</a>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="validation">@_error</div>
                }
            </form>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm] public LoginRequest? Input { get; set; }
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private string? _error;

    protected override void OnInitialized()
    {
        Input ??= new LoginRequest();

        if (HttpContext?.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/pronosticos", forceLoad: true);
        }
    }

    private async Task HandleLogin()
    {
        var input = Input ??= new LoginRequest();

        if (string.IsNullOrWhiteSpace(input.DniNie) || string.IsNullOrWhiteSpace(input.Password))
        {
            _error = "DNI/NIE y contraseña son obligatorios.";
            return;
        }

        var ok = await ApiService.LoginAsync(input.DniNie.Trim(), input.Password);
        if (!ok)
        {
            _error = "Credenciales incorrectas.";
            return;
        }

        var user = ApiService.UsuarioActual;
        if (user is null)
        {
            _error = "No se pudo iniciar sesión.";
            return;
        }

        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, user.usuario_id?.ToString() ?? user.usuario?.usuario_id?.ToString() ?? user.usuario?.empleado_id?.ToString() ?? "0"),
            new(ClaimTypes.Name, user.nombre ?? user.usuario?.nombre ?? input.DniNie),
            new("access_token", user.access_token ?? string.Empty)
        };
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);

        await HttpContext!.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            new ClaimsPrincipal(identity),
            new AuthenticationProperties { IsPersistent = true });

        Navigation.NavigateTo("/pronosticos", forceLoad: true);
    }

    public class LoginRequest
    {
        public string DniNie { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
