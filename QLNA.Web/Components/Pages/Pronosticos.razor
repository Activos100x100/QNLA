@page "/pronosticos"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ApiService ApiService

<PageTitle>Pronósticos - QLNA</PageTitle>

@if (_loading)
{
    <div class="pron-loading">Cargando...</div>
}
else
{
    <div class="pron-selector-wrap">
        <label class="pron-selector-label">Selecciona Torneo:</label>
        <select class="pron-selector" @onchange="OnTorneoChanged" value="@_torneoSeleccionadoId">
            @foreach (var torneo in _torneos)
            {
                <option value="@torneo.id">@torneo.nombre</option>
            }
        </select>
    </div>

    <div class="pron-counters">
        <div class="counter-card">
            <span class="counter-num">@_completos</span>
            <span class="counter-label">Completos</span>
        </div>
        <div class="counter-card">
            <span class="counter-num">@_porHacer</span>
            <span class="counter-label">Por hacer</span>
        </div>
    </div>

    @if (_totalPartidos > 0)
    {
        <div class="pron-progress-wrap">
            <div class="pron-progress-bar" style="width: @((int)(_completos * 100.0 / _totalPartidos))%"></div>
        </div>
    }

    @if (_grupos.Count == 0)
    {
        <p class="muted">No hay partidos disponibles.</p>
    }

    @foreach (var grupo in _grupos)
    {
        <div class="grupo-banner">@grupo.nombre</div>
        @foreach (var partido in (grupo.partidos ?? new()))
        {
            var pid = partido.id;
            <div class="match-card-v2">
                <div class="match-date">@partido.fecha.ToString("dd MMM yyyy HH:mm")</div>
                <div class="match-teams">
                    <div class="team-col">
                        <span class="team-name">@(partido.equipo_local ?? "Local")</span>
                        <input type="number"
                               class="goal-input-sq"
                               min="0" max="99"
                               value="@partido.pronostico?.goles_local"
                               @onchange="@(e => OnGoalChanged(partido, true, e))"
                               disabled="@PartidoBloqueado(partido)" />
                    </div>
                    <span class="vs-sep">vs</span>
                    <div class="team-col">
                        <span class="team-name">@(partido.equipo_visitante ?? "Visitante")</span>
                        <input type="number"
                               class="goal-input-sq"
                               min="0" max="99"
                               value="@partido.pronostico?.goles_visitante"
                               @onchange="@(e => OnGoalChanged(partido, false, e))"
                               disabled="@PartidoBloqueado(partido)" />
                    </div>
                </div>
                @if (partido.goles_local_real.HasValue && partido.goles_visitante_real.HasValue)
                {
                    <small class="muted">Resultado oficial: @partido.goles_local_real - @partido.goles_visitante_real</small>
                }
                <div class="match-save-row">
                    <button class="btn-save-match @GetSaveClass(pid)"
                            @onclick="@(() => GuardarPartido(partido))"
                            disabled="@IsSaving(pid)">
                        @GetSaveText(pid)
                    </button>
                </div>
            </div>
        }
    }
}

@code {
    private List<Torneo> _torneos = new();
    private List<Grupo> _grupos = new();
    private int _torneoSeleccionadoId;
    private bool _loading = true;
    private int _completos;
    private int _porHacer;
    private int _totalPartidos;

    // Save state per partido: "idle" | "saving" | "saved" | "error"
    private readonly Dictionary<int, string> _saveState = new();

    protected override async Task OnInitializedAsync()
    {
        _torneos = (await ApiService.GetTorneosAsync()).ToList();
        var activo = _torneos.FirstOrDefault(x => x.activo);
        _torneoSeleccionadoId = (activo ?? _torneos.FirstOrDefault())?.id ?? 0;
        await CargarPartidos();
        _loading = false;
    }

    private async Task OnTorneoChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var id))
        {
            _torneoSeleccionadoId = id;
            await CargarPartidos();
        }
    }

    private async Task CargarPartidos()
    {
        _saveState.Clear();
        _grupos.Clear();

        // 1. Try to get grupos with nested partidos
        var grupos = (await ApiService.GetGruposAsync(_torneoSeleccionadoId)).ToList();

        // 2. Load pronosticos to merge
        var pronosticos = await ApiService.GetPronosticosByTorneoAsync(_torneoSeleccionadoId);

        if (grupos.Count > 0 && grupos.Any(g => g.partidos?.Count > 0))
        {
            // Populate pronosticos into grupo partidos
            foreach (var grupo in grupos)
            {
                foreach (var partido in grupo.partidos ?? new())
                {
                    if (pronosticos.TryGetValue(partido.id, out var pron))
                    {
                        partido.pronostico = pron;
                    }
                    else
                    {
                        partido.pronostico ??= new Pronostico { partido_id = partido.id };
                    }
                }
            }
            _grupos = grupos;
        }
        else
        {
            // Fallback: flat list from GetPartidosAsync, group locally
            var partidos = (await ApiService.GetPartidosAsync(_torneoSeleccionadoId)).OrderBy(x => x.fecha).ToList();
            foreach (var partido in partidos)
            {
                if (pronosticos.TryGetValue(partido.id, out var pron))
                {
                    partido.pronostico = pron;
                }
                else
                {
                    partido.pronostico ??= new Pronostico { partido_id = partido.id };
                }
            }

            if (grupos.Count > 0)
            {
                // Grupos exist but partidos were empty — try to fill from flat list using grupo_id if available
                _grupos = grupos.Select(g => new Grupo
                {
                    id = g.id,
                    nombre = g.nombre,
                    partidos = partidos.ToList()
                }).Take(1).ToList();
                if (_grupos.Count == 1)
                {
                    _grupos[0].partidos = partidos;
                }
            }
            else
            {
                // No groups at all — show all under a single banner
                _grupos = new List<Grupo>
                {
                    new Grupo { id = 0, nombre = "Partidos", partidos = partidos }
                };
            }
        }

        // Calculate counters
        var allPartidos = _grupos.SelectMany(g => g.partidos ?? new()).ToList();
        _totalPartidos = allPartidos.Count;
        _completos = allPartidos.Count(p => p.pronostico?.id > 0);
        _porHacer = _totalPartidos - _completos;
    }

    private void OnGoalChanged(Partido partido, bool isLocal, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            partido.pronostico ??= new Pronostico { partido_id = partido.id };
            if (isLocal)
                partido.pronostico.goles_local = value;
            else
                partido.pronostico.goles_visitante = value;
        }
    }

    private bool PartidoBloqueado(Partido partido)
        => partido.goles_local_real.HasValue && partido.goles_visitante_real.HasValue;

    private bool IsSaving(int partidoId)
        => _saveState.TryGetValue(partidoId, out var s) && s == "saving";

    private string GetSaveClass(int partidoId)
    {
        if (!_saveState.TryGetValue(partidoId, out var s)) return string.Empty;
        return s switch
        {
            "saved" => "save-ok",
            "error" => "save-err",
            _ => string.Empty
        };
    }

    private string GetSaveText(int partidoId)
    {
        if (!_saveState.TryGetValue(partidoId, out var s)) return "Guardar";
        return s switch
        {
            "saving" => "Guardando...",
            "saved"  => "Guardado ✓",
            "error"  => "Reintentar",
            _ => "Guardar"
        };
    }

    private async Task GuardarPartido(Partido partido)
    {
        _saveState[partido.id] = "saving";
        StateHasChanged();

        var ok = await ApiService.GuardarPronosticoAsync(partido);
        _saveState[partido.id] = ok ? "saved" : "error";

        if (ok)
        {
            // Increment counter directly since only one partido changed
            _completos++;
            _porHacer = _totalPartidos - _completos;
        }

        StateHasChanged();

        if (ok)
        {
            await Task.Delay(2000);
            _saveState[partido.id] = "idle";
            StateHasChanged();
        }
    }
}
