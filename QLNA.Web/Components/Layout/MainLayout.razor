@inherits LayoutComponentBase

<div class="app-layout">
    <AuthorizeView>
        <Authorized Context="authState">
            <header class="app-header">
                <img src="/img/logo.svg" alt="Activos 100x100" height="40" />
                <div class="user-area">
                    <span class="user-name">@(authState.User.Identity?.Name ?? "Usuario")</span>
                    <form action="/logout" method="post" class="logout-form">
                        <AntiforgeryToken />
                        <button class="btn-primary btn-logout" type="submit">Salir</button>
                    </form>
                </div>
            </header>

            <div class="app-shell">
                <aside class="app-nav">
                    <NavMenu />
                </aside>
                <main class="app-main">
                    <div class="app-content">
                        @Body
                    </div>
                </main>
            </div>
        </Authorized>
        <NotAuthorized>
            @Body
        </NotAuthorized>
    </AuthorizeView>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Se ha producido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
