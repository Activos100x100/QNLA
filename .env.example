# --- Database ---
# Prefer URL from your secret manager in production
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db_name>
DB_SSLMODE=require

# Optional split DB vars (used only if DATABASE_URL is not defined)
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=5432

# --- App/session security ---
SESSION_SECRET=change_me_with_a_long_random_secret
FORCE_HTTPS=false
SESSION_HTTPS_ONLY=false
SESSION_SAME_SITE=lax

# CORS/Host hardening
CORS_ALLOW_ALL=false
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=127.0.0.1,localhost

# Legacy support (set false to forbid app/Archivo .env fallback)
ALLOW_LEGACY_APP_ENV=true

# --- WhatsApp/Webhook security ---
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_REQUIRE_SIGNATURE=true
